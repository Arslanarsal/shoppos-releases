{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShopPOS",
  "version": "0.1.0",
  "identifier": "com.shoppos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ShopPOS",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: shopfile: http://shopfile.localhost https://shopfile.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "ShopPOS",
    "shortDescription": "Shop inventory and sales",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0NDE4MUZFNDk1MUFFRUQKUldUdHJsRkovb0ZCNUZFS1ViS1QxdUtwei9vdlpVVzd6bGExY2dxUDZHUkcwRDM2VmptS2VPSTIK",
      "endpoints": ["https://github.com/Arslanarsal/shoppos-releases/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
